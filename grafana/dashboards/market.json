    {
      "id": 4,
      "type": "stat",
      "title": "Spark throughput",
      "description": "Average processed rows per second of the raw_bars query over its last 10 micro-batches.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(processed_rows_per_sec) AS rows_per_sec FROM (SELECT processed_rows_per_sec FROM pipeline_metrics WHERE query_name = 'raw_bars' ORDER BY recorded_at DESC LIMIT 10) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],

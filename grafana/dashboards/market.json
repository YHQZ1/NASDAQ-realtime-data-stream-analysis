    {
      "id": 11,
      "type": "table",
      "title": "Latest anomalies across all symbols",
      "description": "Most recent bars flagged by KMeans. Return is the one-minute log return in basis points, volume z is the volume z-score against that symbol's half-hour baseline (capped at 10) and score is the distance to the nearest cluster centre.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(bar_time, 'MM-DD HH24:MI') AS \"bar (UTC)\", symbol, round((bar_return * 10000)::numeric, 1) AS \"return (bps)\", round(z_volume::numeric, 1) AS \"volume z\", round(kmeans_score::numeric, 2) AS score, CASE WHEN zscore_anomaly THEN 'yes' ELSE 'no' END AS \"z-score also\" FROM anomaly_scores WHERE kmeans_anomaly AND $__timeFilter(bar_time) ORDER BY bar_time DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Spark processed rows per second, by query (last 30 min)",
      "description": "Throughput reported by Structured Streaming progress events for each of the four concurrent queries reading the same Kafka topic.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "timeFrom": "30m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(recorded_at, '10s'), query_name AS metric, avg(processed_rows_per_sec) AS rows_per_sec FROM pipeline_metrics WHERE $__timeFilter(recorded_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",

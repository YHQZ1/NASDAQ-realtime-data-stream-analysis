    {
      "id": 5,
      "type": "stat",
      "title": "Median produce-to-process latency",
      "description": "Median seconds between a message being produced to Kafka and the start of the Spark micro-batch that processed it, over the latest 5,000 bars.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM processed_time - kafka_time)) AS latency FROM (SELECT processed_time, kafka_time FROM raw_bars ORDER BY processed_time DESC LIMIT 5000) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "candlestick",
      "title": "$symbol - 5-minute candles with VWAP",
      "description": "Spark tumbling 5-minute windows per symbol: OHLC, summed volume and volume-weighted average price. Candles closing above VWAP show buyers paying up through the window.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, open, high, low, close, volume, vwap FROM agg_5m WHERE symbol = '$symbol' AND $__timeFilter(window_start) ORDER BY window_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "spanNulls": false,
            "insertNulls": 3600000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vwap"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "up": "#0ca30c",
          "down": "#d03b3b"
        },
        "includeAllFields": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Biggest movers over the range",
      "description": "Percentage change from the first 5-minute open to the last 5-minute close in the selected range, showing the six largest gains and six largest losses.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH moves AS (SELECT symbol, (array_agg(close ORDER BY window_start DESC))[1] / (array_agg(open ORDER BY window_start ASC))[1] - 1 AS change FROM agg_5m WHERE $__timeFilter(window_start) GROUP BY symbol), ranked AS (SELECT symbol, change * 100 AS pct_change, row_number() OVER (ORDER BY change DESC) AS up_rank, row_number() OVER (ORDER BY change ASC) AS down_rank FROM moves) SELECT symbol, pct_change FROM ranked WHERE up_rank <= 6 OR down_rank <= 6 ORDER BY pct_change DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              }
            ]
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "symbol",
        "showValue": "always",
        "barWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 8,
      "type": "status-history",
      "title": "Volatility regime by ticker (bps)",
      "description": "Mean 15-minute rolling standard deviation of one-minute log returns, in basis points, for the 15 most volatile tickers. Vertical bands show market-wide volatility events; rows that stay dark are structurally more volatile names.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-market"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-market"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(window_start, '30m'), symbol AS metric, avg(volatility) * 10000 AS volatility_bps FROM volatility WHERE $__timeFilter(window_start) AND symbol IN (SELECT symbol FROM volatility WHERE $__timeFilter(window_start) GROUP BY symbol ORDER BY avg(volatility) DESC LIMIT 15) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "max": 15,
          "color": {
            "mode": "continuous-blues"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "colWidth": 0.95,
        "rowHeight": 0.9,
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      }
    },
